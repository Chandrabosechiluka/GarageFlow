{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "GarageFlow",
    "Audience": "GarageFlow.Api",
    "ExpiryMinutes": 60,
    "SigningKey": "SET_IN_USER_SECRETS"
  },
  "Maintenance": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "NoShowGraceMinutes": 30,
    "ReminderLeadHours": 24,
    "BatchSize": 100
  },
  "Swagger": {
    "Enabled": false
  },
  "Hosting": {
    "BehindProxy": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60
  },
  "Bootstrap": {
    "ShopName": "GarageFlow",
    "OpeningTime": "09:00",
    "ClosingTime": "18:00",
    "TimeZoneId": "Asia/Kolkata",
    "AdminDisplayName": "Administrator"
  },
  "ConnectionStrings": {
    "GarageFlow": "Server=localhost,1433;Database=GarageFlow;User Id=sa;Password=SET_IN_USER_SECRETS;TrustServerCertificate=True"
  }
}
