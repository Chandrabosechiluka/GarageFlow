# Copy this file to ".env" (which Git ignores) and choose your OWN password.
# SQL Server rules: at least 8 characters, with 3 of: uppercase, lowercase, digit, symbol.
# Avoid these characters, they break the connection string or PowerShell: $ ; = ' " `
MSSQL_SA_PASSWORD=ChangeMe_Str0ng_Pass

# Only needed to run the API inside Docker ("docker compose --profile api up --build -d").
# A long random string, 40+ characters. Never commit the real one.
JWT_SIGNING_KEY=ChangeMe_to_a_long_random_string_of_at_least_40_characters
